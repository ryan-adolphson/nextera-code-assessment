generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js" // matches "module": "nodenext" in tsconfig
}

datasource db {
  provider = "postgresql"
}

/// A wind farm: a unique location. Seeded from prisma/data/farms.csv.
model Farm {
  id          String                @id // e.g. "FARM01"
  name        String
  latitude    Decimal               @db.Decimal(9, 6)
  longitude   Decimal               @db.Decimal(9, 6)
  turbines    Turbine[]
  /// 30-minute Open-Meteo weather at the farm's coordinates (one series per farm).
  weather     FarmWeather[]
  /// 30-minute rollups of the farm's telemetry (the farm series' open/close/high/low per metric).
  rollups     FarmTelemetryRollup[]
  /// Live totals of the farm, rebuilt every minute by the live-summary job.
  liveSummary FarmLiveSummary?

  @@map("farms")
}

/// A turbine belongs to exactly one farm. (The CSV's farm_name is not stored: it comes from the farm.)
model Turbine {
  /// Internal surrogate key: UUID v4 generated by Postgres, like telemetry.id. Not exposed by the API.
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Business key, e.g. "TURB001": used by payloads, CSVs, API URLs and SSE events.
  turbineId       String           @unique @map("turbine_id")
  farmId          String           @map("farm_id")
  farm            Farm             @relation(fields: [farmId], references: [id], onDelete: Restrict)
  latitude        Decimal          @db.Decimal(9, 6)
  longitude       Decimal          @db.Decimal(9, 6)
  /// Whether the turbine has been commissioned (handed over to operations). turbines.csv has no
  /// such column, so seeded turbines stay false.
  commissioned    Boolean          @default(false)
  telemetry       Telemetry[]
  /// The turbine's newest reading: at most one row (turbine_latest's primary key is turbine_id).
  /// A list because Prisma needs a unique (turbine_id, farm_id) on turbine_latest for a one-to-one
  /// composite relation, which would be a second index on a table that takes an update per reading.
  latest          TurbineLatest[]
  anomalyEpisodes AnomalyEpisode[]

  /// Target of the telemetry composite foreign key (turbine_id, farm_id).
  @@unique([turbineId, farmId])
  /// A farm's turbines in id order, and the fleet sorted by farm (keyset paging of GET /api/turbines).
  @@index([farmId, turbineId])
  /// The commissioned filter and sort of GET /api/turbines.
  @@index([commissioned, turbineId])
  /// Substring search on the turbine id (ILIKE '%…%'): needs the pg_trgm extension (migration).
  @@index([turbineId(ops: raw("gin_trgm_ops"))], type: Gin, map: "turbines_turbine_id_trgm_idx")
  @@map("turbines")
}

/// One 5-minute reading from a turbine on a farm.
/// farm_id is stored for farm-level queries; the composite foreign key to turbines(turbine_id, farm_id)
/// guarantees it is always the turbine's own farm.
///
/// PARTITIONED in Postgres (migration 20261104120000_scale_partitions_latest): daily range
/// partitions on "timestamp" plus a DEFAULT partition, which is why the primary key is
/// (id, timestamp). Prisma can't model partitions: it sees one table. Partitions are created and
/// dropped by the partition-maintenance job (see src/wind/partitions.ts).
model Telemetry {
  /// UUID v4 generated by Postgres (gen_random_uuid(), built in since PG 13), so inserts that
  /// bypass Prisma (raw SQL, psql, other tools) get an id too.
  id            String           @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  turbineId     String           @map("turbine_id")
  farmId        String           @map("farm_id")
  turbine       Turbine          @relation(fields: [turbineId, farmId], references: [turbineId, farmId], onDelete: Restrict)
  /// When the turbine measured the values (UTC).
  timestamp     DateTime         @db.Timestamptz(3)
  /// When the platform received it; later than `timestamp` for delayed records.
  receivedAt    DateTime         @default(now()) @map("received_at") @db.Timestamptz(3)
  /// When the row was inserted (set by Postgres, never by the app). Unlike received_at, which a
  /// payload or CSV can set for backfills, this is always the real write time.
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  powerOutputKw Float            @map("power_output_kw")
  windSpeedMs   Float            @map("wind_speed_ms")
  rotorRpm      Float            @map("rotor_rpm")
  bladePitchDeg Float            @map("blade_pitch_deg")
  gearboxTempC  Float            @map("gearbox_temp_c")
  /// The alert rules this reading triggered when it was ingested (see TelemetryAlert).
  alerts        TelemetryAlert[]

  /// The partition key is part of the primary key.
  @@id([id, timestamp])
  /// One reading per turbine per instant: makes ingestion and seeding idempotent
  /// (Pub/Sub redeliveries and re-sent readings are ignored) and serves per-turbine time-range queries.
  @@unique([turbineId, timestamp])
  @@index([farmId, timestamp])
  /// The farm rollup's incremental scan: rows inserted since its watermark.
  @@index([createdAt])
  @@map("telemetry")
}

/// A telemetry measurement an alert can watch. One value per numeric column of `telemetry`;
/// the Prisma names equal TELEMETRY_METRICS in src/wind/responses.ts (a test keeps them in step).
enum MeasurementMetric {
  powerOutputKw @map("power_output_kw")
  windSpeedMs   @map("wind_speed_ms")
  rotorRpm      @map("rotor_rpm")
  bladePitchDeg @map("blade_pitch_deg")
  gearboxTempC  @map("gearbox_temp_c")

  @@map("measurement_metric")
}

/// Which side of the threshold triggers the alert.
enum AlertComparison {
  above
  below

  @@map("alert_comparison")
}

enum AlertLevel {
  info
  warn
  error

  @@map("alert_level")
}

/// An alert threshold, e.g. gearbox_temp_c above 120 → error.
model AlertConfig {
  /// UUID v4 generated by Postgres, like telemetry.id.
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  measurementMetric MeasurementMetric @map("measurement_metric")
  comparison        AlertComparison
  valueMetric       Float             @map("value_metric")
  alertLevel        AlertLevel        @map("alert_level")
  /// Disabled rules are kept but not evaluated. A rule that readings triggered cannot be deleted
  /// (telemetry_alerts.alert_id is ON DELETE RESTRICT): disable it instead.
  enabled           Boolean           @default(true)
  telemetryAlerts   TelemetryAlert[]

  /// One threshold per metric, direction and level (e.g. one "gearbox above → error"), so rules
  /// never contradict each other. A duplicate is rejected with 409 by the API.
  @@unique([measurementMetric, comparison, alertLevel])
  @@map("alerts_config")
}

/// The alert rules a telemetry reading triggered when it was ingested, evaluated by ingestion
/// against the rules enabled at the time (one row per reading and rule; most readings have none).
/// Reads join alerts_config, so they show each rule as it is now.
///
/// PARTITIONED like telemetry (daily on reading_timestamp, plus a DEFAULT partition), so dropping
/// a day of telemetry drops its alerts with it. reading_timestamp is the reading's `timestamp`.
model TelemetryAlert {
  telemetryId      String      @map("telemetry_id") @db.Uuid
  /// The reading's timestamp (the partition key, and the second half of the foreign key).
  /// TEMPORARY default: the previous revision doesn't write this column. A BEFORE INSERT trigger
  /// (telemetry_alerts_fill_reading_timestamp) re-inserts such rows with the reading's timestamp.
  /// A later migration removes the default and the trigger.
  readingTimestamp DateTime    @default(dbgenerated("'1970-01-01 00:00:00+00'::timestamp with time zone")) @map("reading_timestamp") @db.Timestamptz(3)
  /// The rows only describe their reading: deleting a reading removes them.
  telemetry        Telemetry   @relation(fields: [telemetryId, readingTimestamp], references: [id, timestamp], onDelete: Cascade)
  alertId          String      @map("alert_id") @db.Uuid
  /// A rule that fired cannot be deleted, only disabled (409 from the API).
  alert            AlertConfig @relation(fields: [alertId], references: [id], onDelete: Restrict)

  @@id([telemetryId, alertId, readingTimestamp])
  /// "Which readings did this rule flag?", and the RESTRICT check when a rule is deleted.
  @@index([alertId])
  /// Flagged readings newest first, keyset-paged by GET /api/alerts.
  @@index([readingTimestamp, telemetryId])
  @@map("telemetry_alerts")
}

/// A user's one role. Hierarchical (viewer < owner < admin, ROLE_RANK in src/auth/roles.ts): a
/// route declares the minimum role and every higher role passes.
enum Role {
  /// Watches the fleet: farms, telemetry, live updates, alert history and the rules list.
  viewer
  /// A viewer who also creates, edits and deletes alert rules and runs reports.
  owner
  /// Everything.
  admin

  @@map("role")
}

/// Someone who signs in to the web app. Created by `npm run db:seed` (no sign-up or user
/// management endpoints yet).
model User {
  /// UUID v4 generated by Postgres; the JWT `sub`. Never the email.
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Normalised (trimmed, lower-case) by the app before it is stored or looked up.
  email              String               @unique
  /// argon2id PHC string ($argon2id$v=19$m=…), never the password.
  passwordHash       String               @map("password_hash")
  role               Role
  /// Inactive users cannot sign in, and their tokens stop working on the next request.
  active             Boolean              @default(true)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Unallocated turbines this user blocked.
  blockedUnallocated UnallocatedTurbine[]

  @@map("users")
}

/// Why a turbine's readings could not be stored in telemetry.
enum UnallocatedKind {
  /// The turbine id is not in `turbines`.
  unknown_turbine
  /// The turbine exists, but on another farm than the one the readings report.
  farm_mismatch

  @@map("unallocated_kind")
}

enum UnallocatedStatus {
  /// Readings are held (held_telemetry) until an owner assigns, keeps, moves or blocks it.
  pending
  /// Readings for this (turbine, reported farm) are dropped on arrival until it is unblocked.
  blocked

  @@map("unallocated_status")
}

/// A (turbine id, reported farm) pair whose readings ingestion could not store: an unknown turbine
/// or a farm mismatch. Pending ones hold their readings (held_telemetry, at most HELD_RETENTION_MS);
/// blocked ones drop them. At most MAX_PENDING_UNALLOCATED pending entries (src/wind/unallocated.ts).
model UnallocatedTurbine {
  /// UUID v4 generated by Postgres; the only id the API exposes for an entry (actions need it).
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The turbine id the readings report (e.g. "TURB099"); no FK: the turbine may not exist.
  turbineId      String            @map("turbine_id")
  /// The farm id the readings report; no FK: the farm may not exist either.
  reportedFarmId String            @map("reported_farm_id")
  /// As classified when the last reading was held (assigning a turbine updates its siblings).
  kind           UnallocatedKind
  status         UnallocatedStatus @default(pending)
  /// When the platform received the first / the latest reading for this pair (server clock).
  firstSeenAt    DateTime          @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt     DateTime          @map("last_seen_at") @db.Timestamptz(3)
  blockedAt      DateTime?         @map("blocked_at") @db.Timestamptz(3)
  /// Who blocked it; kept as null if that user is deleted.
  blockedById    String?           @map("blocked_by") @db.Uuid
  blockedBy      User?             @relation(fields: [blockedById], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  held           HeldTelemetry[]

  /// One entry per pair: a block applies to (turbine, reported farm) only.
  @@unique([turbineId, reportedFarmId])
  /// The Pending / Blocked lists, newest activity first, and the pending-entries cap.
  @@index([status, lastSeenAt])
  @@map("unallocated_turbines")
}

/// Readings of a pending unallocated turbine, as reported (farm_id is the reported farm), with the
/// same columns as telemetry. Moved into telemetry when the turbine is assigned, kept or moved;
/// deleted with their entry (block, or after the import).
model HeldTelemetry {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unallocatedId String             @map("unallocated_id") @db.Uuid
  unallocated   UnallocatedTurbine @relation(fields: [unallocatedId], references: [id], onDelete: Cascade)
  turbineId     String             @map("turbine_id")
  farmId        String             @map("farm_id")
  timestamp     DateTime           @db.Timestamptz(3)
  receivedAt    DateTime           @default(now()) @map("received_at") @db.Timestamptz(3)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  powerOutputKw Float              @map("power_output_kw")
  windSpeedMs   Float              @map("wind_speed_ms")
  rotorRpm      Float              @map("rotor_rpm")
  bladePitchDeg Float              @map("blade_pitch_deg")
  gearboxTempC  Float              @map("gearbox_temp_c")

  /// One reading per entry per instant: holding is idempotent like telemetry.
  @@unique([unallocatedId, timestamp])
  @@map("held_telemetry")
}

/// 30 minutes of Open-Meteo weather at a farm's coordinates (the grid is 2–25 km, coarser than the
/// turbine spacing, so there is one series per farm), aggregated from the two 15-minute values
/// (`minutely_15`) at :00/:15 or :30/:45 of the forecast models: the Historical Forecast API for
/// past days, the Forecast API for the most recent ones; a later fetch overwrites the row. Written
/// by the weather sync (src/weather/sync-weather.ts); daily figures are computed from these rows on
/// read. Every metric is nullable: Open-Meteo returns null for values it doesn't have.
model FarmWeather {
  farmId                String   @map("farm_id")
  farm                  Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  /// Start of the 30-minute UTC bucket (:00 or :30).
  time                  DateTime @db.Timestamptz(3)
  /// 15-minute values the bucket was aggregated from (1 or 2; buckets without any are not stored).
  samples               Int      @db.SmallInt
  /// Means of the 15-minute values.
  windSpeed10mMs        Float?   @map("wind_speed_10m_ms")
  /// 80 m: the Open-Meteo level closest to hub height.
  windSpeed80mMs        Float?   @map("wind_speed_80m_ms")
  /// Vector means of the 15-minute directions, 0–360.
  windDirection10mDeg   Float?   @map("wind_direction_10m_deg")
  windDirection80mDeg   Float?   @map("wind_direction_80m_deg")
  /// Maximum of the 15-minute gusts.
  windGusts10mMs        Float?   @map("wind_gusts_10m_ms")
  temperature2mC        Float?   @map("temperature_2m_c")
  relativeHumidity2mPct Float?   @map("relative_humidity_2m_pct")
  surfacePressureHpa    Float?   @map("surface_pressure_hpa")
  /// Sum of the 15-minute values.
  precipitationMm       Float?   @map("precipitation_mm")
  cloudCoverPct         Float?   @map("cloud_cover_pct")
  /// When the sync last wrote the row.
  fetchedAt             DateTime @default(now()) @map("fetched_at") @db.Timestamptz(3)

  /// One row per farm and 30 minutes; also serves the farm's time-range reads.
  @@id([farmId, time])
  @@map("farm_weather")
}

/// 30 minutes of a farm's telemetry, precomputed by the farm rollup job (src/wind/farm-rollup.ts,
/// `node dist/farm-rollup/main.js`). The farm series has one point per measurement timestamp: power
/// is the sum over the turbines that reported, the other metrics their mean. Per metric the
/// bucket's open/close (first/last point), high and low. Daily candles are aggregated from these
/// rows on read (GET /api/farms/:farmId/telemetry/daily), so days follow any time zone. Derived
/// data: a run deletes and rewrites a farm's rows from the earliest bucket that changed; rows
/// older than FARM_ROLLUP_RETENTION_DAYS (190) before the newest reading are pruned.
model FarmTelemetryRollup {
  farmId           String   @map("farm_id")
  farm             Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  /// Start of the 30-minute UTC bucket (:00 or :30).
  bucketStart      DateTime @map("bucket_start") @db.Timestamptz(3)
  /// Readings in the bucket.
  readings         Int
  /// Distinct turbines that reported in the bucket.
  turbines         Int
  powerOpen        Float    @map("power_open")
  powerClose       Float    @map("power_close")
  powerHigh        Float    @map("power_high")
  powerLow         Float    @map("power_low")
  windSpeedOpen    Float    @map("wind_speed_open")
  windSpeedClose   Float    @map("wind_speed_close")
  windSpeedHigh    Float    @map("wind_speed_high")
  windSpeedLow     Float    @map("wind_speed_low")
  rotorRpmOpen     Float    @map("rotor_rpm_open")
  rotorRpmClose    Float    @map("rotor_rpm_close")
  rotorRpmHigh     Float    @map("rotor_rpm_high")
  rotorRpmLow      Float    @map("rotor_rpm_low")
  bladePitchOpen   Float    @map("blade_pitch_open")
  bladePitchClose  Float    @map("blade_pitch_close")
  bladePitchHigh   Float    @map("blade_pitch_high")
  bladePitchLow    Float    @map("blade_pitch_low")
  gearboxTempOpen  Float    @map("gearbox_temp_open")
  gearboxTempClose Float    @map("gearbox_temp_close")
  gearboxTempHigh  Float    @map("gearbox_temp_high")
  gearboxTempLow   Float    @map("gearbox_temp_low")
  /// When the run that wrote the row ran.
  computedAt       DateTime @default(now()) @map("computed_at") @db.Timestamptz(3)

  /// One row per farm and 30 minutes; also serves the farm's range reads.
  @@id([farmId, bucketStart])
  @@map("farm_telemetry_rollups")
}

/// The farm rollup's progress: one row (id 1). `watermark` is the database time at which the last
/// successful run started; the next run rescans telemetry rows created since (minus a lookback for
/// transactions that were still open). Written in the run's transaction, so a failed run leaves it.
model FarmRollupState {
  id        Int      @id @default(1) @db.SmallInt
  watermark DateTime @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("farm_rollup_state")
}

/// Farms whose rollups must be recomputed from `from_time`, for changes created_at can't show: a
/// turbine moved to another farm rewrites telemetry.farm_id (ON UPDATE CASCADE) without new rows.
/// Written by the trigger turbines_farm_rollup_dirty (one row for the old farm, one for the new,
/// from the turbine's first reading) in the move's transaction; consumed by the next rollup run.
/// No FK to farms: a marker for a farm deleted since is harmless.
model FarmRollupDirty {
  id        BigInt   @id @default(autoincrement())
  farmId    String   @map("farm_id")
  fromTime  DateTime @map("from_time") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("farm_rollup_dirty")
}

/// The newest reading of each turbine: one row per turbine, upserted by ingestion in the same
/// transaction as the reading, only when the reading is newer than the row (a late reading never
/// overwrites a newer one). Serves the fleet's list, markers and summaries without scanning
/// telemetry. A turbine with no reading has no row. The composite foreign key makes a move
/// (turbines.farm_id) carry farm_id along, like telemetry. Indexes are kept minimal: the table
/// takes one update per reading (fillfactor 70 in the migration).
model TurbineLatest {
  turbineId       String      @id @map("turbine_id")
  farmId          String      @map("farm_id")
  turbine         Turbine     @relation(fields: [turbineId, farmId], references: [turbineId, farmId], onDelete: Cascade)
  /// The reading's id in telemetry (with `timestamp`, its primary key).
  readingId       String      @map("reading_id") @db.Uuid
  /// Measurement time of the newest reading.
  timestamp       DateTime    @db.Timestamptz(3)
  receivedAt      DateTime    @map("received_at") @db.Timestamptz(3)
  powerOutputKw   Float       @map("power_output_kw")
  windSpeedMs     Float       @map("wind_speed_ms")
  rotorRpm        Float       @map("rotor_rpm")
  bladePitchDeg   Float       @map("blade_pitch_deg")
  gearboxTempC    Float       @map("gearbox_temp_c")
  /// The most severe level among the rules the reading triggered (error > warn > info); null if none.
  worstAlertLevel AlertLevel? @map("worst_alert_level")

  /// A farm's turbines in id order (keyset paging).
  @@index([farmId, turbineId])
  /// Last-seen sorting (keyset on (timestamp, turbine_id)), staleness counts and the newest reading.
  @@index([timestamp, turbineId])
  @@map("turbine_latest")
}

/// Live totals of a farm, rebuilt from turbine_latest every minute by the live-summary job
/// (`node dist/live-summary/main.js`). `asOf` is the job's clock for the staleness counts.
model FarmLiveSummary {
  farmId        String   @id @map("farm_id")
  farm          Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  /// All turbines of the farm, and how many are commissioned.
  turbines      Int
  commissioned  Int
  /// Turbines whose newest reading is at most LIVE_REPORTING_MINUTES (15) old at `asOf`.
  reporting     Int
  /// Turbines with a reading, but older than that. turbines - reporting - stale have no reading.
  stale         Int
  /// Reporting turbines whose newest reading triggered at least one alert rule.
  alerting      Int
  /// Sum of the reporting turbines' power, and the mean of their wind speed; 0 / null if none report.
  powerOutputKw Float    @map("power_output_kw")
  windSpeedMs   Float?   @map("wind_speed_ms")
  asOf          DateTime @map("as_of") @db.Timestamptz(3)

  @@map("farm_live_summary")
}

/// An anomaly episode (see wind/anomalies.ts), stored by the hourly anomaly-rollup job with the
/// same rules `listAnomalies` applies on read. Whole episodes (not clipped to a query range).
/// The job deletes and rewrites the episodes that overlap the window it recomputes.
model AnomalyEpisode {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// 'low_power_in_wind' or 'stuck_sensor'.
  kind         String
  /// stuck_sensor: 'gearboxTempC' | 'windSpeedMs' | 'rotorRpm'; null for low_power_in_wind.
  metric       String?
  turbineId    String   @map("turbine_id")
  farmId       String   @map("farm_id")
  turbine      Turbine  @relation(fields: [turbineId, farmId], references: [turbineId, farmId], onDelete: Cascade)
  /// Measurement time of the first and the last reading of the episode.
  episodeStart DateTime @map("episode_start") @db.Timestamptz(3)
  episodeEnd   DateTime @map("episode_end") @db.Timestamptz(3)
  readings     Int
  /// stuck_sensor: the repeated value.
  value        Float?
  /// low_power_in_wind: the episode's mean wind speed.
  windSpeedMs  Float?   @map("wind_speed_ms")
  /// low_power_in_wind: estimated lost energy (kWh); null when no reading had an expected power.
  lostKwh      Float?   @map("lost_kwh")
  computedAt   DateTime @default(now()) @map("computed_at") @db.Timestamptz(3)

  /// Newest-first lists and range overlap.
  @@index([episodeEnd])
  /// One turbine's episodes; the rollup finds its open episodes here.
  @@index([turbineId, episodeStart])
  @@index([farmId, episodeEnd])
  @@map("anomaly_episodes")
}

/// Expected power per 1 m/s wind bin: the median power of the fleet's readings in the bin over the
/// calibration window (a sample of turbines on large fleets), rewritten by the anomaly-rollup job.
/// Only bins with at least EXPECTED_POWER_MIN_BIN_READINGS readings are stored. The same estimate
/// `listAnomalies` derives from its own range on read.
model AnomalyExpectedPower {
  /// floor(wind speed in m/s).
  windBin    Int      @id @map("wind_bin")
  expectedKw Float    @map("expected_kw")
  /// Readings the median is over.
  readings   Int
  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz(3)

  @@map("anomaly_expected_power")
}

/// The anomaly rollup's progress: one row (id 1). `asOf` is the end of the window the last
/// successful run covered; the next run recomputes from a lookback before it.
model AnomalyRollupState {
  id        Int      @id @default(1) @db.SmallInt
  asOf      DateTime @map("as_of") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("anomaly_rollup_state")
}
