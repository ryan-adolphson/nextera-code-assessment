generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js" // matches "module": "nodenext" in tsconfig
}

datasource db {
  provider = "postgresql"
}

/// A wind farm: a unique location. Seeded from prisma/data/farms.csv.
model Farm {
  id        String    @id // e.g. "FARM01"
  name      String
  latitude  Decimal   @db.Decimal(9, 6)
  longitude Decimal   @db.Decimal(9, 6)
  turbines  Turbine[]

  @@map("farms")
}

/// A turbine belongs to exactly one farm. (The CSV's farm_name is not stored: it comes from the farm.)
model Turbine {
  /// Internal surrogate key: UUID v4 generated by Postgres, like telemetry.id. Not exposed by the API.
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Business key, e.g. "TURB001": used by payloads, CSVs, API URLs and SSE events.
  turbineId    String      @unique @map("turbine_id")
  farmId       String      @map("farm_id")
  farm         Farm        @relation(fields: [farmId], references: [id], onDelete: Restrict)
  latitude     Decimal     @db.Decimal(9, 6)
  longitude    Decimal     @db.Decimal(9, 6)
  /// Whether the turbine has been commissioned (handed over to operations). turbines.csv has no
  /// such column, so seeded turbines stay false.
  commissioned Boolean     @default(false)
  telemetry    Telemetry[]

  /// Target of the telemetry composite foreign key (turbine_id, farm_id).
  @@unique([turbineId, farmId])
  @@index([farmId])
  @@map("turbines")
}

/// One 5-minute reading from a turbine on a farm.
/// farm_id is stored for farm-level queries; the composite foreign key to turbines(turbine_id, farm_id)
/// guarantees it is always the turbine's own farm.
model Telemetry {
  /// UUID v4 generated by Postgres (gen_random_uuid(), built in since PG 13), so inserts that
  /// bypass Prisma (raw SQL, psql, other tools) get an id too.
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  turbineId     String           @map("turbine_id")
  farmId        String           @map("farm_id")
  turbine       Turbine          @relation(fields: [turbineId, farmId], references: [turbineId, farmId], onDelete: Restrict)
  /// When the turbine measured the values (UTC).
  timestamp     DateTime         @db.Timestamptz(3)
  /// When the platform received it; later than `timestamp` for delayed records.
  receivedAt    DateTime         @default(now()) @map("received_at") @db.Timestamptz(3)
  /// When the row was inserted (set by Postgres, never by the app). Unlike received_at, which a
  /// payload or CSV can set for backfills, this is always the real write time.
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  powerOutputKw Float            @map("power_output_kw")
  windSpeedMs   Float            @map("wind_speed_ms")
  rotorRpm      Float            @map("rotor_rpm")
  bladePitchDeg Float            @map("blade_pitch_deg")
  gearboxTempC  Float            @map("gearbox_temp_c")
  /// The alert rules this reading triggered when it was ingested (see TelemetryAlert).
  alerts        TelemetryAlert[]

  /// One reading per turbine per instant: makes ingestion and seeding idempotent
  /// (Pub/Sub redeliveries and re-sent readings are ignored) and serves per-turbine time-range queries.
  @@unique([turbineId, timestamp])
  @@index([farmId, timestamp])
  @@map("telemetry")
}

/// A telemetry measurement an alert can watch. One value per numeric column of `telemetry`;
/// the Prisma names equal TELEMETRY_METRICS in src/wind/responses.ts (a test keeps them in step).
enum MeasurementMetric {
  powerOutputKw @map("power_output_kw")
  windSpeedMs   @map("wind_speed_ms")
  rotorRpm      @map("rotor_rpm")
  bladePitchDeg @map("blade_pitch_deg")
  gearboxTempC  @map("gearbox_temp_c")

  @@map("measurement_metric")
}

/// Which side of the threshold triggers the alert.
enum AlertComparison {
  above
  below

  @@map("alert_comparison")
}

enum AlertLevel {
  info
  warn
  error

  @@map("alert_level")
}

/// An alert threshold, e.g. gearbox_temp_c above 120 → error.
model AlertConfig {
  /// UUID v4 generated by Postgres, like telemetry.id.
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  measurementMetric MeasurementMetric @map("measurement_metric")
  comparison        AlertComparison
  valueMetric       Float             @map("value_metric")
  alertLevel        AlertLevel        @map("alert_level")
  /// Disabled rules are kept but not evaluated. A rule that readings triggered cannot be deleted
  /// (telemetry_alerts.alert_id is ON DELETE RESTRICT): disable it instead.
  enabled           Boolean           @default(true)
  telemetryAlerts   TelemetryAlert[]

  /// One threshold per metric, direction and level (e.g. one "gearbox above → error"), so rules
  /// never contradict each other. A duplicate is rejected with 409 by the API.
  @@unique([measurementMetric, comparison, alertLevel])
  @@map("alerts_config")
}

/// The alert rules a telemetry reading triggered, evaluated by ingestion against the rules enabled
/// when the reading arrived (one row per reading and rule; most readings have none). Reads join
/// alerts_config, so they show each rule as it is now.
model TelemetryAlert {
  telemetryId String      @map("telemetry_id") @db.Uuid
  /// The rows only describe their reading: deleting a reading removes them.
  telemetry   Telemetry   @relation(fields: [telemetryId], references: [id], onDelete: Cascade)
  alertId     String      @map("alert_id") @db.Uuid
  /// A rule that fired cannot be deleted, only disabled (409 from the API).
  alert       AlertConfig @relation(fields: [alertId], references: [id], onDelete: Restrict)

  @@id([telemetryId, alertId])
  /// "Which readings did this rule flag?", and the RESTRICT check when a rule is deleted.
  @@index([alertId])
  @@map("telemetry_alerts")
}
