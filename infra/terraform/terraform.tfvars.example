# Copy to terraform.tfvars (gitignored).
project_id = "my-gcp-project"
region     = "us-central1"

# Optional custom domains (leave empty to use the *.run.app URLs)
api_domain = "api.example.com"
web_domain = "app.example.com"

# GitHub Actions deploys + migrations (Workload Identity Federation, no keys)
github_repository = "my-org/nextera-code-assessment"
# github_repository_id = "123456789"   # recommended: `gh api repos/OWNER/REPO --jq .id` (immutable, unlike the name)
# github_environment = "production"

# deletion_protection     = false   # throwaway environments only
# db_tier                 = "db-g1-small"
# db_high_availability    = true
# api_max_instances       = 5
# ingestion_max_instances = 5
# web_max_instances       = 3
# ingestion_invokers      = ["group:wind-ops@example.com"]   # may upload CSVs to the worker
# db_pool_max             = 4
# jwt_issuer              = "nextera-api"   # JWT iss/aud the API signs and requires
# jwt_audience            = "nextera-web"
# demo_feed_enabled       = true    # live demo telemetry every 5 min (run `npm run db:seed:demo` first)
# demo_feed_paused        = true    # keep the demo feed, stop its schedule
# weather_sync_enabled    = true    # daily Open-Meteo weather per farm (Cloud Run Job + Scheduler)
# weather_sync_paused     = true    # keep the weather sync, stop its schedule
# weather_sync_schedule   = "30 1 * * *"   # cron, UTC
# open_meteo_api_key_enabled = true # secret open-meteo-api-key (add its value with gcloud); commercial use needs it
# farm_rollup_enabled     = false   # on by default: the farm History tab's rollups (Cloud Run Job + Scheduler)
# farm_rollup_paused      = true    # keep the farm rollup, stop its schedule (History goes stale)
# farm_rollup_schedule    = "*/15 * * * *"   # cron, UTC
# partition_maintenance_enabled = false      # on by default: daily partitions + retention (do not pause > 3 days)
# partition_maintenance_paused  = true
# partition_maintenance_schedule = "17 3 * * *"   # cron, UTC, off-peak
# telemetry_retention_days = 31              # raw readings kept; whole-day partitions are dropped
# live_summary_enabled    = false            # on by default: runs EVERY MINUTE (~43,200 executions/month, see live-summary.tf)
# live_summary_paused     = true
# live_summary_schedule   = "*/5 * * * *"    # cheaper: a fifth of the executions
# anomaly_rollup_enabled  = false            # on by default: hourly anomaly episodes
# anomaly_rollup_paused   = true
# anomaly_rollup_schedule = "7 * * * *"      # cron, UTC

# Monitoring (monitoring.tf): every alert policy exists regardless; these add email notifications
# alert_emails            = ["wind-ops@example.com"]
# billing_account         = "012345-6789AB-CDEF01"   # optional monthly budget (needs roles/billing.costsManager)
# monthly_budget          = 200                      # whole units of the billing account's currency
