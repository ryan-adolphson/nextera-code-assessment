{
  "name": "@nextera/mcp",
  "version": "0.0.1",
  "description": "Local stdio MCP server: read-only fleet tools for Claude over Postgres (Prisma).",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "nextera-mcp": "dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nextera/shared": "*",
    "@prisma/adapter-pg": "^7.10.0",
    "dotenv": "^18.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nextera/testing": "*",
    "@types/node": "^24.0.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2",
    "vitest-mock-extended": "^5.1.1"
  },
  "engines": {
    "node": ">=24"
  }
}
