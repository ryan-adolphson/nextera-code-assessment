# nginx server for the Angular build (Cloud Run service nextera-web).
# A template: the image's entrypoint substitutes ${PORT} (only; NGINX_ENVSUBST_FILTER) into
# /etc/nginx/conf.d/default.conf at startup. nginx variables ($uri ...) are left alone.
#
# Caching: Angular's file names are content-hashed (outputHashing: all), so *.js / *.css are
# immutable for a year. Everything else (index.html, the SPA fallback, /config.json, favicon,
# media) is `no-cache`: the browser revalidates (ETag) and picks up a new deploy immediately.

# Keyed on the status too: a 404 for a missing chunk must never be cached as immutable.
map "$status $uri" $nextera_cache_control {
  "~^(?:200|206|304) .*\.(?:js|css)$" "public, max-age=31536000, immutable";
  default                              "no-cache";
}

# The API origin for the CSP's connect-src, written at container start by 40-runtime-config.sh from
# API_BASE_URL (that script runs after envsubst, so the value can't be a template variable). nginx
# refuses to start if the file is missing, so the policy never goes out without it.
map $host $nextera_api_origin {
  include /usr/share/nginx/runtime/api-origin.map;
}

server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;

  server_tokens off;
  # Behind Cloud Run's TLS front end: never redirect to http://<host>:${PORT}.
  absolute_redirect off;

  # On every response, errors included (`always`). A location with its own add_header would drop
  # ALL of these, so no location below may use add_header.
  add_header Cache-Control $nextera_cache_control always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  # Superseded by frame-ancestors in browsers with CSP; kept for old ones.
  add_header X-Frame-Options "DENY" always;
  # Ignored by browsers over plain http (compose on http://localhost:8082). No includeSubDomains or
  # preload: web_domain may sit under a parent domain we don't own.
  add_header Strict-Transport-Security "max-age=31536000" always;
  # The JWT lives in localStorage (accepted PoC trade-off), so this is the main XSS defence in depth.
  # - script-src 'self': no inline scripts; the build turns off critical-CSS inlining (its
  #   <link onload>/inline script would need 'unsafe-inline').
  # - style-src 'unsafe-inline': Angular adds Material/CDK component styles as <style> elements at
  #   runtime, and ECharts' SVG renderer and Angular templates set style="" attributes.
  # - img-src: OpenStreetMap tiles (map-view.ts) and data: URIs; connect-src: the API (REST + SSE)
  #   and /config.json.
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://tile.openstreetmap.org; font-src 'self'; connect-src 'self' $nextera_api_origin; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

  # Cloud Run doesn't compress responses; Firebase Hosting used to.
  gzip on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_types text/css application/javascript application/json image/svg+xml text/plain;

  # Container probe (Terraform startup/liveness probes, compose HEALTHCHECK).
  location = /health/live {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # Runtime config written at container start from API_BASE_URL (40-runtime-config.sh).
  location = /config.json {
    alias /usr/share/nginx/runtime/config.json;
  }

  # A missing script or stylesheet (e.g. a chunk from an older deploy) is a 404, never index.html:
  # an HTML fallback would be cached as "immutable" JavaScript.
  location ~* \.(?:js|css)$ {
    try_files $uri =404;
  }

  # SPA fallback: deep links (/farms/FARM01/turbines/TURB001) get index.html.
  location / {
    try_files $uri /index.html;
  }
}
