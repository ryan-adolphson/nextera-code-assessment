# Copy to .env and adjust. Never commit .env.
# This is the single .env for the repo: docker-compose, the API (apps/api) and Prisma all read it.

# Postgres container (docker-compose.yml)
POSTGRES_USER=nextera
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nextera
POSTGRES_PORT=5433

# Redis container (docker-compose.yml). 6380 avoids clashing with a local Redis on 6379.
REDIS_PORT=6380

# API (port 3000) and ingestion worker (port 3001) run on the host against the compose containers.
# Inside compose, the services override these with postgres:5432 / redis:6379. Cloud Run sets PORT.
DATABASE_URL=postgresql://nextera:change-me@localhost:5433/nextera?schema=public
REDIS_URL=redis://localhost:6380
DB_POOL_MAX=5
# MCP server (apps/mcp, read-only sessions): uses DATABASE_URL unless this is set (e.g. a SELECT-only role).
# MCP_DATABASE_URL=

# Local Pub/Sub emulator (docker-compose). Unset PUBSUB_EMULATOR_HOST to publish to real GCP.
PUBSUB_EMULATOR_HOST=localhost:8085
GOOGLE_CLOUD_PROJECT=nextera-local
PUBSUB_TOPIC=telemetry

# Container images (docker compose build/push, npm run docker:build / docker:push):
# tagged $REGISTRY/api:$TAG, $REGISTRY/ingestion:$TAG and $REGISTRY/web:$TAG. Artifact Registry example (Terraform
# `registry` output): REGISTRY=us-central1-docker.pkg.dev/my-project/nextera
REGISTRY=nextera
TAG=latest

# Angular dev server origin, allowed by the API's CORS (comma-separated). The compose api also
# always allows the compose web container (http://localhost:$WEB_PORT and http://127.0.0.1:$WEB_PORT).
CORS_ORIGINS=http://localhost:4200

# Sign-in (API). JWT_SECRET is the HS256 key of the access tokens: at least 32 characters, no default
# (the API refuses to start without it). Generate one with `openssl rand -base64 48` (64 characters).
# In GCP it comes from Secret Manager (jwt-secret). Never commit a real one.
JWT_SECRET=
JWT_ISSUER=nextera-api
JWT_AUDIENCE=nextera-web

# Password of the test users `npm run db:seed` creates (viewer@, owner@ and admin@nextera.local).
# At least 12 characters, no default: the seed refuses to run without it.
SEED_USER_PASSWORD=

# Demo data (npm run db:seed:demo): generated telemetry for 25 demo turbines up to SEED_NOW (default
# now, ISO 8601 with a zone) for the last SEED_HOURS (default 72), with alerts. Re-running tops up.
# SEED_NOW=2026-10-08T12:00:00Z
# SEED_HOURS=72

# Live demo feed (npm run demo:feed, or `node dist/demo-feed/main.js` in the ingestion image):
# publishes one reading per demo turbine to PUBSUB_TOPIC every DEMO_FEED_INTERVAL_SECONDS,
# continuing the demo seed. Off unless DEMO_FEED_ENABLED=true; --once (or DEMO_FEED_ONCE=true)
# publishes one tick and exits (a Cloud Run Job on a Cloud Scheduler trigger).
# Also the switch of the compose demo-feed service: after changing it, `docker compose up -d demo-feed`.
# Run `npm run db:seed:demo` first (readings for turbines the database doesn't know are rejected).
DEMO_FEED_ENABLED=false
DEMO_FEED_INTERVAL_SECONDS=300

# Compose web container (nginx + Angular production build), like Cloud Run nextera-web.
WEB_PORT=8082
