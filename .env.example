# Copy to .env and adjust. Never commit .env.
# This is the single .env for the repo: docker-compose, the API (apps/api) and Prisma all read it.

# Postgres container (docker-compose.yml)
POSTGRES_USER=nextera
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nextera
POSTGRES_PORT=5433

# Redis container (docker-compose.yml). 6380 avoids clashing with a local Redis on 6379.
REDIS_PORT=6380

# API (port 3000) and ingestion worker (port 3001) run on the host against the compose containers.
# Inside compose, the services override these with postgres:5432 / redis:6379. Cloud Run sets PORT.
DATABASE_URL=postgresql://nextera:change-me@localhost:5433/nextera?schema=public
REDIS_URL=redis://localhost:6380
DB_POOL_MAX=5

# Local Pub/Sub emulator (docker-compose). Unset PUBSUB_EMULATOR_HOST to publish to real GCP.
PUBSUB_EMULATOR_HOST=localhost:8085
GOOGLE_CLOUD_PROJECT=nextera-local
PUBSUB_TOPIC=telemetry

# Container images (docker compose build/push, npm run docker:build / docker:push):
# tagged $REGISTRY/api:$TAG, $REGISTRY/ingestion:$TAG and $REGISTRY/web:$TAG. Artifact Registry example (Terraform
# `registry` output): REGISTRY=us-central1-docker.pkg.dev/my-project/nextera
REGISTRY=nextera
TAG=latest

# Angular dev server origin, allowed by the API's CORS (comma-separated). The compose api also
# always allows the compose web container (http://localhost:$WEB_PORT and http://127.0.0.1:$WEB_PORT).
CORS_ORIGINS=http://localhost:4200

# Compose web container (nginx + Angular production build), like Cloud Run nextera-web.
WEB_PORT=8082
